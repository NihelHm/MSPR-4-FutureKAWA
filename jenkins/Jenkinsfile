pipeline {
    agent any

    stages {

        stage('Checkout') {
            steps {
                echo 'Code récupéré depuis GitHub'
            }
        }

        stage('Check project structure') {
            steps {
                sh 'ls -la'
                sh 'ls -la bresil'
                sh 'ls -la colombie'
                sh 'ls -la equateur'
                sh 'ls -la siege'
            }
        }

        stage('Check Python files') {
            steps {
                sh 'python3 --version || python --version'
                sh 'find . -name "*.py"'
            }
        }

        stage('Validate Docker compose files') {
            steps {
                sh 'find . -name "docker-compose.yml"'
            }
        }
    }
}