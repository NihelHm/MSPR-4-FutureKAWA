pipeline {
    agent any

    stages {

        stage('Build Bresil') {
            steps {
                dir('bresil') {
                    sh 'docker compose build'
                }
            }
        }

        stage('Build Colombie') {
            steps {
                dir('colombie') {
                    sh 'docker compose build'
                }
            }
        }

        stage('Build Equateur') {
            steps {
                dir('equateur') {
                    sh 'docker compose build'
                }
            }
        }

        stage('Build Siege') {
            steps {
                dir('siege') {
                    sh 'docker compose build'
                }
            }
        }

        stage('Check Docker') {
            steps {
                sh 'docker ps -a'
            }
        }
    }
}