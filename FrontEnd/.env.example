# ==========================================================
# Configuration des URLs backend (Vite)
# Copier ce fichier en `.env` et adapter si besoin.
# ==========================================================

# Backend central SIÈGE (auth + administration des utilisateurs)
VITE_SIEGE_URL=http://localhost:8003

# Backends locaux par pays (données métier : sites, lots, capteurs, mesures)
VITE_URL_BRESIL=http://localhost:8000
VITE_URL_COLOMBIE=http://localhost:8002
VITE_URL_EQUATEUR=http://localhost:8001
